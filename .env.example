# Copy to .env and fill in secrets. Never commit .env.
# Comments sit on their own lines so both python-dotenv and docker compose parse values cleanly.

# dev | test | prod
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak@localhost:5432/sahayak
REDIS_URL=redis://localhost:6379/0

# --- Observability
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# none | console (defaults to console when APP_ENV=dev)
OTEL_TRACES_EXPORTER=console

# --- LLM
# azure_openai | anthropic
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Speech
# sarvam | whisper | indicconformer
STT_PROVIDER=sarvam
# sarvam | indic_parler
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_VOICE=

# --- Embeddings
# local | azure_openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Sessions and admin
ADMIN_API_KEY=
PHONE_HASH_SALT=
SESSION_TTL_DAYS=30
MAX_QUESTIONS_PER_SESSION=8

# --- Scheme discovery (crons are interpreted in Asia/Kolkata)
DISCOVERY_ENABLED=true
DISCOVERY_DAILY_CRON=0 6 * * *
DISCOVERY_PIB_CRON=0 */6 * * *
# comma-separated state codes
DISCOVERY_STATES=MH
# above: auto-match to an existing scheme
DISCOVERY_MATCH_AUTO_THRESHOLD=0.90
# between review and auto: send to the review queue
DISCOVERY_MATCH_REVIEW_THRESHOLD=0.70
CRAWLER_USER_AGENT=SahayakBot/1.0 (+contact email)
CRAWLER_RATE_LIMIT_PER_DOMAIN=1/s
REVIEW_DIGEST_WEBHOOK_URL=
STALE_AFTER_DAYS=90

# --- Accounts
# entra_external_id | firebase | msg91 (chosen in M10-T01)
AUTH_PROVIDER=
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Document vault
# minio | azure_blob
BLOB_BACKEND=minio
AZURE_STORAGE_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
VAULT_KEK_NAME=sahayak-kek
# must be <= 300 (NFR Security)
SIGNED_URL_TTL_SEC=300
MAX_UPLOAD_MB=10
CLAMAV_HOST=clamav
# vision_llm | azure_doc_intel | tesseract
DOC_EXTRACTOR=vision_llm

# --- Result filtering
SHOW_PROVISIONAL_SCHEMES=true
APPLICATION_WINDOW_LOOKAHEAD_DAYS=60

# --- Reminders (cron interpreted in Asia/Kolkata)
REMINDER_CRON=0 9 * * *
DOC_EXPIRY_OFFSETS_DAYS=30,7,0
DEADLINE_OFFSETS_DAYS=14,3
QUIET_HOURS=21:00-08:00
MAX_REMINDERS_PER_DAY=1
SMS_PROVIDER=
SMS_DLT_ENTITY_ID=
EMAIL_PROVIDER=
ACCOUNT_INACTIVITY_DELETE_MONTHS=24

# --- Local docker-compose services (only used by docker-compose.yml)
MINIO_ROOT_USER=sahayak
MINIO_ROOT_PASSWORD=change-me-locally
