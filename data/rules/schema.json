{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Condition"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Condition"
              },
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/Not"
              }
            ]
          },
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "ApplicationWindow": {
      "additionalProperties": false,
      "description": "When applications are accepted (TRD §8C; used from M10). An open end is None.",
      "properties": {
        "opens": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opens"
        },
        "closes": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closes"
        }
      },
      "title": "ApplicationWindow",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "op": {
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in",
            "not_in",
            "exists"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "DocumentRequirement": {
      "additionalProperties": false,
      "description": "A document the applicant must hold, valid on the given date (TRD §8C; used from M10).",
      "properties": {
        "type": {
          "description": "document_types id, e.g. income_certificate",
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "valid_on": {
          "default": "today",
          "enum": [
            "today",
            "application_deadline"
          ],
          "title": "Valid On",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "DocumentRequirement",
      "type": "object"
    },
    "Not": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            },
            {
              "$ref": "#/$defs/Not"
            }
          ],
          "title": "Not"
        }
      },
      "required": [
        "not"
      ],
      "title": "Not",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where in the source documents a rule comes from, for review and citations.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "url",
        "section"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One versioned eligibility rule of a scheme, as stored and exported (TRD §9.2).",
  "properties": {
    "scheme_id": {
      "minLength": 1,
      "title": "Scheme Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "rejected",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "logic": {
      "anyOf": [
        {
          "$ref": "#/$defs/Condition"
        },
        {
          "$ref": "#/$defs/AllOf"
        },
        {
          "$ref": "#/$defs/AnyOf"
        },
        {
          "$ref": "#/$defs/Not"
        }
      ],
      "title": "Logic"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "required_documents": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DocumentRequirement"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Documents"
    },
    "application_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplicationWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reviewed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed By"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    }
  },
  "required": [
    "scheme_id",
    "version",
    "status",
    "logic"
  ],
  "title": "SchemeRule",
  "type": "object"
}
