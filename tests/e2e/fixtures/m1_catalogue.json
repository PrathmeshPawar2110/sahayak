    },
    {
      "scheme_id": "pm-kisan",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "land_holding_acres",
            "op": ">",
            "value": 0
          },
          {
            "not": {
              "any": [
                {
                  "field": "is_govt_employee",
                  "op": "==",
                  "value": true
                },
                {
                  "field": "is_income_tax_payer",
                  "op": "==",
                  "value": true
                },
                {
                  "field": "is_non_creamy_layer",
                  "op": "==",
                  "value": false
                },
                {
                  "field": "occupation",
                  "op": "in",
                  "value": [
                    "doctor",
                    "engineer",
                    "lawyer",
                    "chartered_accountant",
                    "architect"
                  ]
                }
              ]
            }
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://pmkisan.gov.in/Documents/RevisedPM-KISANOperationalGuidelines(English).pdf",
          "section": "Exclusions"
        },
        {
          "url": "https://pmkisan.gov.in/Documents/RevisedPM-KISANOperationalGuidelines(English).pdf",
          "section": "Scheme"
        },
        {
          "url": "https://pmkisan.gov.in/Documents/RevisedPM-KISANOperationalGuidelines(English).pdf",
          "section": "Methodology for calculation of benefit"
        }
      ],
      "notes": "Main criteria include holding cultivable land and not being a government employee or income tax payer. NRIs are excluded as well as individuals with certain professions."
    },
    {
      "scheme_id": "pm-sym",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "age",
            "op": ">=",
            "value": 18
          },
          {
            "field": "age",
            "op": "<=",
            "value": 40
          },
          {
            "field": "annual_family_income_inr",
            "op": "<=",
            "value": 180000
          },
          {
            "field": "occupation",
            "op": "in",
            "value": [
              "farmer",
              "agri_labourer",
              "daily_wage",
              "street_vendor",
              "artisan",
              "unemployed",
              "other"
            ]
          },
          {
            "not": {
              "any": [
                {
                  "field": "is_income_tax_payer",
                  "op": "==",
                  "value": true
                },
                {
                  "field": "is_govt_employee",
                  "op": "==",
                  "value": true
                }
              ]
            }
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/mar/doc202534512301.pdf",
          "section": "Pradhan Mantri Shram Yogi Maandhan Yojana"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/mar/doc202534512301.pdf",
          "section": "Eligibility Criteria"
        }
      ],
      "notes": "The eligibility conditions specify a maximum monthly income of ₹15,000, which corresponds to an annual income of ₹180,000. The scheme is specifically targeted at unorganised workers. Exact occupations are hard to enforce due to generic nature; categorized generally."
    },
    {
      "scheme_id": "pm-vishwakarma",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "occupation",
            "op": "in",
            "value": [
              "carpenter",
              "blacksmith",
              "potter",
              "washerman",
              "tailor",
              "garland maker",
              "cobbler",
              "barber",
              "mason"
            ]
          },
          {
            "field": "residence",
            "op": "in",
            "value": [
              "rural",
              "urban"
            ]
          },
          {
            "field": "age",
            "op": ">=",
            "value": 18
          },
          {
            "field": "is_govt_employee",
            "op": "!=",
            "value": true
          },
          {
            "field": "is_income_tax_payer",
            "op": "!=",
            "value": true
          },
          {
            "field": "is_bpl",
            "op": "==",
            "value": true
          },
          {
            "field": "is_non_creamy_layer",
            "op": "==",
            "value": true
          },
          {
            "field": "education_level",
            "op": "exists"
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/sep/doc2025916638501.pdf",
          "section": "Who Can Apply? Vishwakarma Scheme Eligibility Explained"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/sep/doc2025916638501.pdf",
          "section": "Eligibility conditions to be a beneficiary under the PM Vishwakarma Scheme"
        }
      ],
      "notes": "The occupation list may not be exhaustive. Residency condition based on rural and urban focus. Excluded government employees as specified."
    },
    {
      "scheme_id": "pmay-g",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "residence",
            "op": "==",
            "value": "rural"
          },
          {
            "field": "is_income_tax_payer",
            "op": "!=",
            "value": true
          },
          {
            "not": {
              "any": [
                {
                  "field": "is_govt_employee",
                  "op": "==",
                  "value": true
                },
                {
                  "field": "annual_family_income_inr",
                  "op": ">",
                  "value": 180000
                },
                {
                  "field": "land_holding_acres",
                  "op": ">",
                  "value": 2.5
                }
              ]
            }
          },
          {
            "any": [
              {
                "field": "is_bpl",
                "op": "==",
                "value": true
              },
              {
                "field": "is_minority",
                "op": "==",
                "value": true
              },
              {
                "field": "land_holding_acres",
                "op": "<=",
                "value": 0
              },
              {
                "field": "occupation",
                "op": "in",
                "value": [
                  "homemaker",
                  "unemployed"
                ]
              },
              {
                "field": "disability",
                "op": "==",
                "value": true
              },
              {
                "field": "caste_name",
                "op": "in",
                "value": [
                  "sc",
                  "st"
                ]
              }
            ]
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2024/nov/doc20241119437801.pdf",
          "section": "Eligibility Criteria for Beneficiaries"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2024/nov/doc20241119437801.pdf",
          "section": "Compulsory Inclusion Criteria:"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2024/nov/doc20241119437801.pdf",
          "section": "Exclusion Criteria"
        }
      ],
      "notes": "Households with a monthly income over ₹15,000 are excluded. Specific criteria based on living conditions and verification surveys are not fully expressible with available fields."
    },
