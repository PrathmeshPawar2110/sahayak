  "rules": [
    {
      "scheme_id": "ab-pmjay",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "state",
            "op": "not_in",
            "value": [
              "DL",
              "WB",
              "OD"
            ]
          },
          {
            "field": "age",
            "op": ">=",
            "value": 70
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2024/sep/doc2024923400001.pdf",
          "section": "Free Health Coverage for All Seniors 70+"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2024/sep/doc2024912393201.pdf",
          "section": "World's Largest Health Insurance Scheme extends free health cover to"
        }
      ],
      "notes": "The scheme provides additional benefits for those aged 70 or above, irrespective of their socio-economic status, but excludes those in NCT of Delhi, West Bengal, and Odisha. The core scheme primarily targets the poorest 40% based on the Socio-Economic Caste Census 2011, which cannot be mapped with the provided fields."
    },
    {
      "scheme_id": "apy",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "age",
            "op": ">=",
            "value": 18
          },
          {
            "field": "age",
            "op": "<=",
            "value": 40
          },
          {
            "field": "is_income_tax_payer",
            "op": "==",
            "value": false
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/may/doc202558551701.pdf",
          "section": "Eligibility Criteria Requirement Age"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/may/doc202558551701.pdf",
          "section": "1. Target Group"
        },
        {
          "url": "https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/may/doc202558551701.pdf",
          "section": "Income Taxpayer Status"
        }
      ],
      "notes": "Eligibility requires the individual to be within the age range of 18 to 40 years and not an income taxpayer from 1st October 2022. The scheme is targeted at the informal sector, and having a bank account is mandatory for enrollment."
    },
    {
      "scheme_id": "mh-majhi-ladki-bahin",
      "version": 1,
      "status": "draft",
      "logic": {
        "all": [
          {
            "field": "state",
            "op": "==",
            "value": "MH"
          },
          {
            "field": "gender",
            "op": "==",
            "value": "female"
          },
          {
            "field": "age",
            "op": ">=",
            "value": 21
          },
          {
            "field": "age",
            "op": "<=",
            "value": 65
          },
          {
            "field": "annual_family_income_inr",
            "op": "<=",
            "value": 250000
          },
          {
            "any": [
              {
                "field": "marital_status",
                "op": "==",
                "value": "married"
              },
              {
                "field": "marital_status",
                "op": "==",
                "value": "widowed"
              },
              {
                "field": "marital_status",
                "op": "==",
                "value": "divorced"
              }
            ]
          }
        ]
      },
      "source_refs": [
        {
          "url": "https://pune.gov.in/scheme/mukhyamantri-majhi-ladki-bahin-yojana/",
          "section": "Mukhyamantri – Majhi Ladki Bahin Yojana"
        },
        {
          "url": "https://pune.gov.in/scheme/mukhyamantri-majhi-ladki-bahin-yojana/",
          "section": "Eligibility"
        }
      ],
      "notes": "The scheme is specifically for women residing in Maharashtra who are between 21 and 65 years and have an annual family income not exceeding ₹2,50,000. Marital status criteria include married, widowed, and divorced, but there's no field for abandoned or destitute women, or identifying the unmarried woman in a family who can be eligible."
    },
    {
